# Links used across the site (all optional)
NEXT_PUBLIC_LUMA_URL=https://luma.com/chooseyourlondon
# Public URL used in the "Post on X" text. Defaults to the current page URL.
NEXT_PUBLIC_SITE_URL=https://choseyourlondon.com

# Bean leaderboard storage (Upstash Redis). Vercel sets these for you when you add
# Storage → Upstash for Redis to the project. Without them, counts are kept in memory (local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
